{
  "name": "@pepuscz/dsh-ssh-connector",
  "version": "0.1.3",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pepuscz/deepseek-harness-minimal-remote.git"
  },
  "homepage": "https://github.com/pepuscz/deepseek-harness-minimal-remote#readme",
  "type": "module",
  "description": "DSH desktop connector for pinned loopback or certificate-verified private HTTPS hosts",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  }
}
